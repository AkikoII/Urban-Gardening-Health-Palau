# ============================================
# Step 4.7: Regression Analyses for Individual Food Items (11 Foods)
# ============================================
foods_all <- c("Grain2", "Meat2", "Fish2", "Taro2", "Vegetables2", 
               "Fruits2", "Beans2", "Nuts2", "Seaweed2", "Dairy2", "Egg2")

for (food in foods_all) {
  # Skip Grain2 due to complete separation (quasi-complete separation)
  if (food == "Grain2") {
    cat("Skipped: Grain2 (Model 1a) - Nearly all participants consumed grains.\n")
    next
  }
  
  f <- as.formula(paste(food, "~ Age + Sex + Edu + Occu + HG.VW"))
  
  fit_list <- lapply(1:d_miced$m, function(i) {
    df_imputed <- complete(d_miced, action = i)
    glm(f, data = df_imputed, family = binomial)
  })
  
  mean_aic <- mean(sapply(fit_list, AIC))
  
  res <- summary(pool(fit_list), conf.int = TRUE, conf.level = 0.95) %>%
    mutate(OR = exp(estimate), OR_low = exp(conf.low), OR_high = exp(conf.high)) %>%
    mutate(
      OR = if_else(std.error > 10, NA_real_, OR),
      OR_low = if_else(std.error > 10, NA_real_, OR_low),
      OR_high = if_else(std.error > 10, NA_real_, OR_high)
    ) %>%
    add_row(term = "AIC", estimate = mean_aic)
  
  out_name <- paste0("summary_miced_pool_FDSK", food, ".csv")
  write.csv(res, file.path("outputs", out_name), row.names = TRUE)
  
  cat("Completed:", food, "(Mean AIC:", round(mean_aic, 2), ") -> outputs/", out_name, "\n")
}


