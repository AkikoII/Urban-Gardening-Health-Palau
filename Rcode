#-----------------------------------------------------------------------------------------
# R CODE for "Urban gardening and its associations with diet and health in Palau facing an obesity crisis"
#-----------------------------------------------------------------------------------------

#----------------------------------------------
# STEP 1 Data setting & A Priori Power Analysis
#----------------------------------------------

# Set working directory (Please update to your local path)
# setwd("path/to/your/directory")

# Load required packages
library(mice)
library(dplyr)
library(tidyr)
library(ggplot2)
library(scales)
library(pwr)

# Load dataset
d <- read.csv("260726_data_edit_HG_Diet_Health.csv", header = TRUE, sep = ",", stringsAsFactors = FALSE)

# Set variable types
d <- d %>%
  select(
    HG.O, HG.VW, Health2, Sex, Edu, Occu, 
    Grain2, Taro2, Meat2, Fish2, Egg2, Dairy2, 
    Vegetables2, Seaweed2, Beans2, Nuts2, Fruits2, 
    UrbanKA, Palauan,
    Age, BMI, FDSKsome
  ) %>%
  mutate(
    across(c(HG.O, HG.VW, Health2, Sex, Edu, Occu, 
             Grain2, Taro2, Meat2, Fish2, Egg2, Dairy2, 
             Vegetables2, Seaweed2, Beans2, Nuts2, Fruits2, 
             UrbanKA, Palauan), as.factor),
    across(c(Age, BMI, FDSKsome), as.numeric)
  )

# Subset data to include urban Palauans only (exclude rural residents and non-Palauans)
d <- subset(d, Palauan == 1)
d <- subset(d, UrbanKA == 1)

# Min-Max normalize Age to a 0–1 scale
d <- d %>%
  mutate(Age = (Age - min(Age, na.rm = TRUE)) / (max(Age, na.rm = TRUE) - min(Age, na.rm = TRUE)))

summary(d)

# Select variables required for analysis
d <- d[, c("Age", "Sex", "Edu", "Occu", "HG.O", "HG.VW", "BMI", "FDSKsome", "Health2", 
           "Grain2", "Taro2", "Egg2", "Dairy2", "Vegetables2", "Seaweed2", "Beans2", "Nuts2", "Fruits2", "Meat2", "Fish2")]

head(d)
sum(is.na(d)) # Total count of missing values
nrow(d)       # Total rows (N = 181)
ncol(d)       # Total columns (20 variables)
na_percentage_total <- mean(is.na(d)) * 100; print(na_percentage_total)

# Create output directory automatically if it does not exist
if (!dir.exists("outputs")) dir.create("outputs")

# --- A Priori Power Analysis ---
f2_val <- 0.15
u_val <- 6
sig_level <- 0.05
target_power <- 0.80

res_lm <- pwr.f2.test(u = u_val, f2 = f2_val, sig.level = sig_level, power = target_power)
required_N_lm <- u_val + ceiling(res_lm$v) + 1

# 2. Binary Logistic Regression (for Self-Reported Health model)
OR_val <- 2.5
p1_val <- 0.52
p2_val <- (OR_val * p1_val) / (1 - p1_val + OR_val * p1_val)
h_val <- ES.h(p1 = p1_val, p2 = p2_val)
res_logi <- pwr.2p.test(h = h_val, sig.level = sig_level, power = target_power)

n_per_group <- ceiling(res_logi$n)  
required_N_logi <- n_per_group * 2

required_N_overall <- max(required_N_lm, required_N_logi)

cat("===================================================\n")
cat(" A Priori Power Analysis Results (alpha = 0.05, power = 0.80)\n")
cat("===================================================\n")
cat(" 1. Multiple Linear Regression (f^2 = 0.15, u = 6): Required N =", required_N_lm, "\n")
cat(" 2. Binary Logistic Regression (OR = 2.5, p1 = 0.52): Required N =", required_N_logi, "\n")
cat(" Overall minimum required N (larger of the two) =", required_N_overall, "\n")
cat(" Achieved Sample Size in Study: N =", nrow(d), "\n")
cat("===================================================\n")

