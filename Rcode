#----------------------------------------------
# STEP 3: Multiple Imputation (MICE)
#----------------------------------------------

d_miced <- mice(d, m = 20, maxit = 50, method = "pmm", seed = 1234)
save(d_miced, file = "260726_d_miced_basic.Rdata") 
load(file = "260726_d_miced_basic.Rdata") 


#----------------------------------------------
# STEP 4: Regression Analyses (Models 1–6)
# Order: FDSK-11 (Models 1 & 4) -> BMI (Models 2 & 5) -> Self-reported Health (Models 3 & 6)
#----------------------------------------------

# ============================================
# Model 1: FDSK-11 ~ Gardening Status (HG.VW)
# ============================================
miced_FDSK_m1 <- with(data = d_miced, lm(FDSKsome ~ Age + Sex + Edu + Occu + HG.VW))
miced_pool_FDSK_m1 <- pool(miced_FDSK_m1)
aic_m1 <- mean(sapply(miced_FDSK_m1$analyses, AIC))

summary_miced_pool_FDSK_m1 <- summary(miced_pool_FDSK_m1, conf.int = TRUE, conf.level = 0.95) %>%
  add_row(term = "AIC", estimate = aic_m1)
write.csv(summary_miced_pool_FDSK_m1, "outputs/summary_miced_pool_FDSK_m1.csv", row.names = TRUE)

plot_data_m1 <- summary_miced_pool_FDSK_m1 %>%
  filter(!term %in% c("(Intercept)", "AIC")) %>%
  mutate(
    sig = case_when(p.value < 0.001 ~ "***", p.value < 0.01 ~ "**", p.value < 0.05 ~ "*", p.value < 0.1 ~ ".", TRUE ~ ""),
    var_group = case_when(
      grepl("Age", term) ~ "Age", grepl("Sex", term) ~ "Sex", grepl("Edu", term) ~ "Education",
      grepl("Occu", term) ~ "Employment", grepl("HG.VW", term) ~ "Gardening status", TRUE ~ term
    )
  ) %>%
  group_by(var_group) %>% slice(1) %>% ungroup() %>%
  mutate(
    var_group = factor(var_group, levels = c("Age", "Sex", "Education", "Employment", "Gardening status")),
    color = if_else(var_group == "Gardening status", "#66bd63", "gray60")
  ) %>% filter(!is.na(var_group))

p_model1 <- ggplot(plot_data_m1, aes(x = var_group, y = estimate)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray40") +
  geom_errorbar(aes(ymin = conf.low, ymax = conf.high, color = color), width = 0.2, linewidth = 0.8) +
  geom_point(aes(color = color), size = 3.5) +
  geom_text(aes(y = conf.high, label = sig), vjust = -0.5, size = 5, color = "#08306b") +
  coord_flip() + scale_color_identity() + theme_minimal(base_size = 12) +
  theme(
    axis.text.x = element_text(size = 12, color = "black"),
    axis.text.y = element_text(size = 12, color = "black", face = "bold"),
    panel.background = element_rect(fill = "grey95", color = NA),
    panel.grid.major = element_line(color = "white"), panel.grid.minor = element_line(color = "white")
  ) +
  labs(x = "", y = expression("Estimate (" * beta * ")"), title = "")
print(p_model1)
ggsave("outputs/model1_plot.pdf", plot = p_model1, width = 5, height = 5)


