# 1. Extract and combine odds ratios for Gardening Status (HG.VW) across all food models
combined_food_data <- lapply(foods_all, function(food) {
  file_path <- file.path("outputs", paste0("summary_miced_pool_FDSK", food, ".csv"))
  
  if (file.exists(file_path)) {
    df <- read.csv(file_path)
    df_sub <- df %>% 
      filter(grepl("HG.VW", term)) %>% 
      mutate(
        food_item = food,
        sig = case_when(p.value < 0.001 ~ "***", p.value < 0.01 ~ "**", p.value < 0.05 ~ "*", p.value < 0.1 ~ ".", TRUE ~ "")
      )
    return(df_sub)
  } else {
    return(NULL)
  }
}) %>% bind_rows()

